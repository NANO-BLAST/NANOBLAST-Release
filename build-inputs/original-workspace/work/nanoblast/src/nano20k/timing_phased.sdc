create_clock -name clk -period 37.037037 [get_ports {sys_clk}]
create_generated_clock -name hclk5 -source [get_ports {sys_clk}] -multiply_by 55 -divide_by 4 [get_pins {pll_hdmi/rpll_inst/CLKOUT}]
create_generated_clock -name pixel -source [get_pins {pll_hdmi/rpll_inst/CLKOUT}] -divide_by 5 [get_pins {div5/CLKOUT}]

// Bank-0/1 request capture is phase 0, aligned with the NES edge. The
// earliest preceding NES launch is THREE fast periods earlier. Limit this
// exception to NES/loader sources and CPU/PPU request destinations; do not
// extend it to the separate RV bank-2/3 request interface.
set_multicycle_path -setup -end 3 -from [get_pins {nes/*/Q nes/cpu/*/Q nes/cpu_bus/*/Q nes/dma/*/Q nes/ppu/*/Q nes/ppu/*/*/Q nes/ppu/*/*/*/Q nes/apu/*/Q nes/apu/*/*/Q nes/apu/*/*/*/Q nes/multi_mapper/*/*/Q nes/multi_mapper/*/*/*/Q loader/*/Q loader*/Q mapper_flags*/Q reset_nes*/Q iosys/nes_pal*/Q menu_paused*/Q}] -to [get_pins {sdram/cmd*/D sdram/cmd*/CE sdram/cmd*/RESET sdram/cmd*/SET sdram/a*/D sdram/a*/CE sdram/a*/RESET sdram/a*/SET sdram/SDRAM_BA*/D sdram/SDRAM_BA*/CE sdram/SDRAM_BA*/RESET sdram/SDRAM_BA*/SET sdram/din_latch*/D sdram/din_latch*/CE sdram/din_latch*/RESET sdram/din_latch*/SET sdram/port*/D sdram/port*/CE sdram/port*/RESET sdram/port*/SET sdram/ds*/D sdram/ds*/CE sdram/ds*/RESET sdram/ds*/SET sdram/oe_latch*/D sdram/oe_latch*/CE sdram/oe_latch*/RESET sdram/oe_latch*/SET sdram/we_latch*/D sdram/we_latch*/CE sdram/we_latch*/RESET sdram/we_latch*/SET sdram/oeA_d*/D sdram/oeA_d*/CE sdram/oeA_d*/RESET sdram/oeA_d*/SET sdram/weA_d*/D sdram/weA_d*/CE sdram/weA_d*/RESET sdram/weA_d*/SET sdram/oeB_d*/D sdram/oeB_d*/CE sdram/oeB_d*/RESET sdram/oeB_d*/SET sdram/weB_d*/D sdram/weB_d*/CE sdram/weB_d*/RESET sdram/weB_d*/SET}]
set_multicycle_path -hold -end 2 -from [get_pins {nes/*/Q nes/cpu/*/Q nes/cpu_bus/*/Q nes/dma/*/Q nes/ppu/*/Q nes/ppu/*/*/Q nes/ppu/*/*/*/Q nes/apu/*/Q nes/apu/*/*/Q nes/apu/*/*/*/Q nes/multi_mapper/*/*/Q nes/multi_mapper/*/*/*/Q loader/*/Q loader*/Q mapper_flags*/Q reset_nes*/Q iosys/nes_pal*/Q menu_paused*/Q}] -to [get_pins {sdram/cmd*/D sdram/cmd*/CE sdram/cmd*/RESET sdram/cmd*/SET sdram/a*/D sdram/a*/CE sdram/a*/RESET sdram/a*/SET sdram/SDRAM_BA*/D sdram/SDRAM_BA*/CE sdram/SDRAM_BA*/RESET sdram/SDRAM_BA*/SET sdram/din_latch*/D sdram/din_latch*/CE sdram/din_latch*/RESET sdram/din_latch*/SET sdram/port*/D sdram/port*/CE sdram/port*/RESET sdram/port*/SET sdram/ds*/D sdram/ds*/CE sdram/ds*/RESET sdram/ds*/SET sdram/oe_latch*/D sdram/oe_latch*/CE sdram/oe_latch*/RESET sdram/oe_latch*/SET sdram/we_latch*/D sdram/we_latch*/CE sdram/we_latch*/RESET sdram/we_latch*/SET sdram/oeA_d*/D sdram/oeA_d*/CE sdram/oeA_d*/RESET sdram/oeA_d*/SET sdram/weA_d*/D sdram/weA_d*/CE sdram/weA_d*/RESET sdram/weA_d*/SET sdram/oeB_d*/D sdram/oeB_d*/CE sdram/oeB_d*/RESET sdram/oeB_d*/SET sdram/weB_d*/D sdram/weB_d*/CE sdram/weB_d*/RESET sdram/weB_d*/SET}]

// CPU/PPU read results update only at phase 4; the next NES edge is TWO
// fast periods later. Use the fast launch-clock period (not the slow
// latch-clock period) for this adjustment. Retain the original hold check.
set_multicycle_path -setup -start 2 -from [get_pins {sdram/doutA*/Q sdram/doutB*/Q}] -to [get_pins {nes/*/D nes/*/CE nes/*/RESET nes/*/SET nes/cpu/*/D nes/cpu/*/CE nes/cpu/*/RESET nes/cpu/*/SET nes/cpu_bus/*/D nes/cpu_bus/*/CE nes/cpu_bus/*/RESET nes/cpu_bus/*/SET nes/dma/*/D nes/dma/*/CE nes/dma/*/RESET nes/dma/*/SET nes/ppu/*/D nes/ppu/*/CE nes/ppu/*/RESET nes/ppu/*/SET nes/ppu/*/*/D nes/ppu/*/*/CE nes/ppu/*/*/RESET nes/ppu/*/*/SET nes/ppu/*/*/*/D nes/ppu/*/*/*/CE nes/ppu/*/*/*/RESET nes/ppu/*/*/*/SET nes/apu/*/D nes/apu/*/CE nes/apu/*/RESET nes/apu/*/SET nes/apu/*/*/D nes/apu/*/*/CE nes/apu/*/*/RESET nes/apu/*/*/SET nes/apu/*/*/*/D nes/apu/*/*/*/CE nes/apu/*/*/*/RESET nes/apu/*/*/*/SET}]
set_multicycle_path -hold -start 1 -from [get_pins {sdram/doutA*/Q sdram/doutB*/Q}] -to [get_pins {nes/*/D nes/*/CE nes/*/RESET nes/*/SET nes/cpu/*/D nes/cpu/*/CE nes/cpu/*/RESET nes/cpu/*/SET nes/cpu_bus/*/D nes/cpu_bus/*/CE nes/cpu_bus/*/RESET nes/cpu_bus/*/SET nes/dma/*/D nes/dma/*/CE nes/dma/*/RESET nes/dma/*/SET nes/ppu/*/D nes/ppu/*/CE nes/ppu/*/RESET nes/ppu/*/SET nes/ppu/*/*/D nes/ppu/*/*/CE nes/ppu/*/*/RESET nes/ppu/*/*/SET nes/ppu/*/*/*/D nes/ppu/*/*/*/CE nes/ppu/*/*/*/RESET nes/ppu/*/*/*/SET nes/apu/*/D nes/apu/*/CE nes/apu/*/RESET nes/apu/*/SET nes/apu/*/*/D nes/apu/*/*/CE nes/apu/*/*/RESET nes/apu/*/*/SET nes/apu/*/*/*/D nes/apu/*/*/*/CE nes/apu/*/*/*/RESET nes/apu/*/*/*/SET}]
report_timing -hold -max_paths 100 -max_common_paths 1
report_timing -setup -max_paths 100 -max_common_paths 1
report_timing -setup -from [get_pins {nes/cpu/*/Q}] -to [get_pins {sdram/*/D}] -max_paths 30 -max_common_paths 1
